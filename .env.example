# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Process environment variables override this file; command-line flags override both.

# Required
ASANA_ACCESS_TOKEN=replace-with-your-personal-access-token
ASANA_WORKSPACE_GID=replace-with-your-workspace-gid

# Optional (defaults shown)
ASANA_OUTPUT_DIR=output
ASANA_EXTRACT_INTERVAL=5m
ASANA_HTTP_TIMEOUT=30s
ASANA_RATE_LIMIT_PER_MINUTE=60
ASANA_MAX_RETRIES=5
LOG_LEVEL=info
